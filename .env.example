MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=landing_builder_shared
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
EVENT_RETENTION_DAYS=90
# Set only behind a trusted proxy that OVERWRITES this header on every request.
# Without it, requests share a conservative rate limit. Never trust arbitrary X-Forwarded-For.
TRUSTED_CLIENT_IP_HEADER=

# Google Gemini API key for AI-assisted SEO generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
